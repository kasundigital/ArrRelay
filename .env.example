# ArrRelay normally needs no .env file.
# The first-run wizard stores Discord, Telegram, Radarr and Sonarr settings
# in /data/arrrelay.db, and ArrRelay automatically generates a persistent
# session secret in /data/.arrrelay_secret.
#
# These are optional overrides for advanced/unattended deployments.

WEB_HOST=0.0.0.0
WEB_PORT=3032
DATABASE_PATH=/data/arrrelay.db
LOG_LEVEL=INFO

# Optional: supply your own stable application secret.
# APP_SECRET=

# Optional bootstrap defaults. The web wizard is recommended instead.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
RADARR_ROOT_FOLDER=/movies
RADARR_QUALITY_PROFILE_ID=1
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
SONARR_ROOT_FOLDER=/tv
SONARR_QUALITY_PROFILE_ID=1
AUTO_APPROVE_CONFIDENCE=0.95
DRY_RUN=true
