# ArrRelay web interface
WEB_HOST=0.0.0.0
WEB_PORT=3032
DATABASE_PATH=/data/arrrelay.db
# Change this before exposing ArrRelay outside your LAN.
APP_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=INFO

# Integrations are configured after login in the ArrRelay web UI.
# Optional environment defaults can still be supplied below.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
RADARR_ROOT_FOLDER=/movies
RADARR_QUALITY_PROFILE_ID=1
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
SONARR_ROOT_FOLDER=/tv
SONARR_QUALITY_PROFILE_ID=1
AUTO_APPROVE_CONFIDENCE=0.95
DRY_RUN=true
